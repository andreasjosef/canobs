# Copy this file to .env and fill it in. .env is gitignored; keep it private.

# Canvas → Account → Settings → Approved integrations → New access token
CANVAS_TOKEN=

# Folder where notes are saved. Should be inside your Obsidian vault.
# ~ works on every OS. Examples:
#   NOTES_DIR=~/notes/chas
#   NOTES_DIR=~/Documents/Obsidian/School/chas
#   NOTES_DIR=C:\Users\you\Documents\Obsidian\chas
# NOTES_DIR=~/notes/chas
